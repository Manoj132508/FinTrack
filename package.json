{
  "name": "expense-tracker-analytics",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Responsive financial analytics dashboard to monitor and manage expenses, built with React, Redux Toolkit, and Chart.js.",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --disable-warning=ExperimentalWarning server/server.js",
    "start:api": "node --disable-warning=ExperimentalWarning server/server.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.7",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.4",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "vite": "^5.4.8"
  }
}
